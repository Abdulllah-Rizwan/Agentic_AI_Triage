{
  "expo": {
    "name": "MediReach",
    "slug": "medireach-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "backgroundColor": "#0a0a0a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.medireach.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MediReach needs your location to help responders find you in an emergency.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "MediReach needs your location to help responders find you in an emergency."
      }
    },
    "android": {
      "package": "com.medireach.mobile",
      "softwareKeyboardLayoutMode": "nothing",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MediReach needs your location to help responders find you in an emergency."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withAndroidCleartextHttp"
    ],
    "owner": "abdullah_expo",
    "extra": {
      "eas": {
        "projectId": "bf990b61-5cab-4039-a2cc-0eeed7d63dae"
      }
    }
  }
}

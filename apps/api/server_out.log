                    FILTER (WHERE claimed_at IS NOT NULL)                       AS avg_resp,
                COUNT(*) FILTER (WHERE status = 'RESOLVED') * 100.0
                    / NULLIF(COUNT(*), 0)                                       AS res_rate,
                COUNT(*) FILTER (WHERE received_at >= $1)             AS last_24h
            FROM cases
            WHERE received_at >= $2
        
